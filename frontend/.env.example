# ==============================================================================
# Circle AI Frontend Environment Configuration
# ==============================================================================

# Backend API base URL
# Local dev: http://localhost:8000
# Render deployment: https://<your-backend-service>.onrender.com
VITE_API_URL=http://localhost:8000

# WebSocket URL (optional, automatically derived from VITE_API_URL if omitted)
# Local dev: ws://localhost:8000
# Render deployment: wss://<your-backend-service>.onrender.com
VITE_WS_URL=

# Branding & ISP Display Name
VITE_ISP_NAME="Circle Network"
