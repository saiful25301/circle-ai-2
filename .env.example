# ─── Application ───────────────────────────────────────────────
PROJECT_NAME=Circle AI
VERSION=0.1.0
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
API_V1_STR=/api/v1
DEBUG=true

# ─── Database (PostgreSQL + pgvector) ─────────────────────────
DATABASE_URL=postgresql+asyncpg://circleai:circleai_password@localhost:5432/circleai_db

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=1800

# ─── LLM Configuration ────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/text-embedding-004
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
RAG_TOP_K=5

# ─── NetCare Integration ──────────────────────────────────────
NETCARE_BASE_URL=http://localhost:8000
NETCARE_SERVICE_EMAIL=circleai@circlenetwork.com.bd
NETCARE_SERVICE_PASSWORD=change-this-service-account-password

# ─── WhatsApp Business Cloud API ─────────────────────────────
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-app-secret-for-signature-verification

# ─── Facebook Messenger API ───────────────────────────────────
FACEBOOK_PAGE_ACCESS_TOKEN=your-page-access-token
FACEBOOK_APP_SECRET=your-app-secret
FACEBOOK_VERIFY_TOKEN=your-webhook-verify-token

# ─── Admin ────────────────────────────────────────────────────
ADMIN_JWT_SECRET=change-this-admin-jwt-secret
ADMIN_JWT_EXPIRE_MINUTES=60
ADMIN_REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_DEFAULT_EMAIL=admin@circleai.local
ADMIN_DEFAULT_PASSWORD=change-me-immediately

# ─── CORS ─────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
