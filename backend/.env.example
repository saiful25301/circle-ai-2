# ==============================================================================
# Circle AI — Backend Environment Variables
# ISP: Circle Network (Bangladesh)
# ==============================================================================

PROJECT_NAME="Circle AI"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# Security & Authentication
SECRET_KEY="circle-ai-secret-key-development-minimum-32-characters-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL + pgvector or SQLite for local dev)
# For local dev without Postgres, uses sqlite+aiosqlite:///./circle_ai.db
DATABASE_URL="sqlite+aiosqlite:///./circle_ai.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://circleai:password@localhost:5432/circleai_db"

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# CORS configuration (Frontend origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# ISP Integration Settings (Circle Network OLT & Radius/PPPoE simulator)
ISP_NAME="Circle Network"
ISP_SUPPORT_HOTLINE="09611800800"
ISP_BKASH_MERCHANT_NO="01844XXXXXX"
