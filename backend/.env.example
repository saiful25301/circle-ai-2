# ==============================================================================
# Circle AI — Backend Environment Variables
# ISP: Circle Network (Bangladesh)
# ==============================================================================

PROJECT_NAME="Circle AI"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# Security & Authentication
SECRET_KEY="circle-ai-secret-key-development-minimum-32-characters-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="circle_ai"

# Direct PostgreSQL Async connection string
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/circle_ai"
# Direct PostgreSQL Sync connection string (for Alembic migrations)
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/circle_ai"

# SQLite dev fallback (uncomment if testing locally without PostgreSQL running):
# DATABASE_URL="sqlite+aiosqlite:///./circle_ai.db"
# SYNC_DATABASE_URL="sqlite:///./circle_ai.db"

# Google Gemini API
GEMINI_API_KEY="your-google-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# CORS configuration (Frontend origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","https://chat.circlenetworkbd.net","https://www.circlenetworkbd.net"]

# Rate Limiting (Sliding Window in requests per minute)
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_GENERAL_PER_MIN=120

# ISP Integration Settings (Circle Network Bangladesh Official)
ISP_NAME="Circle Network"
ISP_SUPPORT_HOTLINE="16207"
ISP_WHATSAPP_SUPPORT="01611411211"
ISP_OFFICE_ADDRESS="Unique Heights, Level-8, 117 Kazi Nazrul Islam Avenue, Eskaton, Dhaka, Bangladesh"
ISP_BKASH_MERCHANT_NO="01611411211"
